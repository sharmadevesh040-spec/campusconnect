# ==============================================================================
# CampusConnect Environment Configuration Template
# Complete Firebase Architecture (Cloud Firestore, Auth, Storage)
# ==============================================================================

# Server & Application Settings
PORT=3001
NODE_ENV=production
AUTH_SECRET=campusconnect-jwt-secret-key-2026-production
VITE_APP_URL=https://campusconnect-omega-seven.vercel.app

# Firebase Web & Cloud Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:your_web_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-side Firebase configuration aliases (if not using VITE_ prefix in backend)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# SMTP Authentication Settings (For email verification OTPs and notifications)
# For Vercel Serverless / Cloud Production, Gmail requires Port 465 with SSL (secure: true).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sharmadevesh040@gmail.com
SMTP_PASS=your_16_char_gmail_app_password
SMTP_FROM=CampusConnect <sharmadevesh040@gmail.com>
