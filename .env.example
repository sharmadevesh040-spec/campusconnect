# CampusConnect Environment Configuration Template
DATABASE_URL=postgres://user:password@host:port/database
AUTH_SECRET=your-super-secret-jwt-key
PORT=3001
NODE_ENV=production
VITE_APP_URL=https://campusconnect.edu

# SMTP Authentication Settings
# Use Gmail SMTP, Outlook, SendGrid, Mailgun, AWS SES, or University Mail Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=CampusConnect <noreply@campusconnect.edu>
