# ==============================================================================
# CampusConnect — Student Hub Environment Variables
# ==============================================================================

# Firebase Configuration
# Get these from your Firebase Console -> Project Settings -> General -> Web apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Web Push Notifications (Optional VAPID Public Key)
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here

# App Base URL (Used for generating verification links and redirects)
VITE_APP_URL=http://localhost:5173

# AI Assistant (Secure Backend integration — DO NOT expose raw Gemini secret key in client)
# In production, proxy AI requests through your backend or Cloud Function:
# GEMINI_API_KEY=your_gemini_api_key
