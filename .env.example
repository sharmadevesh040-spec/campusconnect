# CampusConnect Environment Configuration Template
DATABASE_URL=postgres://user:password@host:port/database
AUTH_SECRET=your-super-secret-jwt-key
PORT=3001
NODE_ENV=production
VITE_APP_URL=https://campusconnect.edu

# SMTP Authentication Settings
# For Vercel Serverless / Cloud Production, Gmail requires Port 465 with SSL (secure: true).
# Port 587 STARTTLS times out or gets blocked on AWS Lambda / Vercel Serverless.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sharmadevesh040@gmail.com
SMTP_PASS=your16chargmailapppassword
SMTP_FROM=CampusConnect <sharmadevesh040@gmail.com>
