# ==============================================================================
# CampusConnect — Student Management PWA Environment Variables
# ==============================================================================

# PostgreSQL / Neon Database Connection
# Format: postgres://username:password@ep-your-id.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@ep-example.neon.tech/campusconnect?sslmode=require

# Authentication & JWT Session Secret
AUTH_SECRET=campusconnect-production-secret-2026-supersecure

# Google OAuth Credentials (for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server-Side Gemini API Key (NEVER exposed to frontend client code)
GEMINI_API_KEY=your_gemini_api_key_here

# Object / File Storage (S3 / Cloud Storage / Supabase Storage / Vercel Blob)
# Used for Certificate PDFs, Student Avatars, and Event Documents
STORAGE_ENDPOINT=https://your-storage-endpoint.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_BUCKET=campusconnect-certificates

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Client Public Settings
VITE_APP_URL=http://localhost:5173
VITE_VAPID_PUBLIC_KEY=your_public_vapid_key_here
