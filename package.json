{
  "name": "campusconnct",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,VITE\" -c \"magenta,cyan\" \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "db:migrate": "tsx -e \"import { runMigration } from './server/db'; runMigration().then(() => process.exit(0))\"",
    "db:seed": "tsx -e \"import { seedDatabase } from './server/db/seed'; seedDatabase().then(() => process.exit(0))\""
  },
